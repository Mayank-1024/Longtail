# Copy to .env (git-ignored). Each of us uses our own keys with a spend limit.
MODEL_API_KEY=            # Meta Model API, https://api.meta.ai/v1
BASETEN_API_KEY=          # Muse Spark Open
MODAL_TOKEN_ID=           # Glimmer / batch jobs
MODAL_TOKEN_SECRET=
LONGTAIL_DATA_DIR=./data
LONGTAIL_REPLAY=0         # 1 = serve every model call from cache, fail on a miss
LONGTAIL_QUERY_BUDGET_USD=0.75
LONGTAIL_ALLOW_PAID=0      # 1 = allow real (paid) Meta API calls; keep 0 until the credits are in
LONGTAIL_SPEND_CAP_USD=5   # hard cap over runs/ledger.jsonl; raise to 150 once the credits are confirmed
